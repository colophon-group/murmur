# Murmur — environment template. Copy to .env.local and fill in.
# Production values are written to /home/deploy/.env on the box by the
# deploy GH Action from `production` environment secrets.

# ── Murmur core ─────────────────────────────────────────────────────
PORT=8080
DATABASE_PATH=./murmur.db

# Demo-grade auth (DESIGN §3.6). Generate with: openssl rand -hex 32
AGENT_TOKEN=
PUBLISHER_TOKEN=

# ── Hetzner box (ARM64) ─────────────────────────────────────────────
HETZNER_HOST_IPV4=178.105.51.62
HETZNER_HOST_IPV6=2a01:4f8:1c18:d64c::1
HETZNER_HOST_PRIVATE_IPV4=10.0.0.5

PUBLIC_HOSTNAME=murmur.colophon-group.org
CLOUDFLARE_TUNNEL_TOKEN=

# ── Shared with jobseek CI ──────────────────────────────────────────
OWNER=colophon-group
HETZNER_GH_TOKEN=
CLOUDFLARE_API_TOKEN=

# ── Observability (post-MVP) ────────────────────────────────────────
GRAFANA_PROM_URL=
GRAFANA_PROM_USERNAME=
GRAFANA_PROM_PASSWORD=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USERNAME=
GRAFANA_LOKI_PASSWORD=
